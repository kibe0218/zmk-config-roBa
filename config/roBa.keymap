// スクロール量を変更

#define ZMK_MOUSE_POINTING_SCRL_VAL 100

#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    scroll-layers = <4>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 10>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 11>;
        };

        right_allow {
            bindings = <&kp RIGHT_ARROW>;
            key-positions = <21 20>;
        };

        left_allow {
            bindings = <&kp LEFT_ARROW>;
            key-positions = <19 20>;
        };

        up_allow {
            bindings = <&kp UP_ARROW>;
            key-positions = <8 7>;
        };

        down_allow {
            bindings = <&kp DOWN_ARROW>;
            key-positions = <32 31>;
        };

        pi {
            bindings = <&kp PIPE>;
            key-positions = <8 9>;
        };

        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <33 32>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        to_mac {
            bindings = <&to 0>;
            key-positions = <13 10 11 12>;
        };

        to_win {
            bindings = <&to 1>;
            key-positions = <18 19 20 21>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // 新しいスクロール動作の追加

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            // 追加: スクロールのタップ時間を設定 (20ms)

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer_mac {
            bindings = <
&kp Q                 &kp W                 &mt LS(LEFT_COMMAND) E  &kp R             &kp T                                                                   &kp Y          &kp U  &kp I     &kp O     &kp P
&mt LEFT_CONTROL A    &kp S                 &kp D                   &kp F             &kp G        &kp LS(LG(S))                    &kp MINUS                 &kp H          &kp J  &lt 4 K   &kp L     &mt RIGHT_CONTROL RETURN
&kp Z                 &kp X                 &kp C                   &kp V             &kp B        &kp EQUAL                        &kp SEMICOLON             &kp N          &kp M  &mkp MB1  &mkp MB2  &mt RS(RIGHT_COMMAND) SLASH
&mt LEFT_SHIFT COMMA  &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)   &lt 3 INT_HENKAN  &lt 2 SPACE  &mt LEFT_COMMAND LANGUAGE_2      &mt RIGHT_ALT LANGUAGE_1  &kp BACKSPACE                             &mt RIGHT_SHIFT PERIOD
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        default_layer_win {
            bindings = <
&kp Q                 &kp W                 &mt LS(LEFT_COMMAND) E  &kp R             &kp T                                                                   &kp Y          &kp U  &kp I     &kp O     &kp P
&mt LEFT_CONTROL A    &kp S                 &kp D                   &kp F             &kp G        &kp LS(LG(S))                    &kp MINUS                 &kp H          &kp J  &lt 4 K   &kp L     &mt RIGHT_CONTROL RETURN
&kp Z                 &kp X                 &kp C                   &kp V             &kp B        &kp EQUAL                        &kp SEMICOLON             &kp N          &kp M  &mkp MB1  &mkp MB2  &mt RS(RIGHT_COMMAND) SLASH
&mt LEFT_SHIFT COMMA  &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)   &lt 3 INT_HENKAN  &lt 2 SPACE  &mt LEFT_CONTROL LANGUAGE_2      &mt RIGHT_ALT LANGUAGE_1  &kp BACKSPACE                             &mt RIGHT_SHIFT PERIOD
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        NUM {
            bindings = <
&kp EXCLAMATION               &kp DOUBLE_QUOTES  &kp HASH         &kp DOLLAR       &kp PERCENT                                               &kp AMPERSAND     &kp SINGLE_QUOTE   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp GRAVE
&mt LEFT_CONTROL KP_NUMBER_1  &kp KP_N2          &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5   &kp LC(LA(KP_NUMBER_0))      &kp TILDE  &kp KP_NUMBER_6   &kp KP_NUMBER_7    &kp KP_NUMBER_8       &kp KP_NUMBER_9        &mt RIGHT_CONTROL KP_NUMBER_0
&mt LEFT_SHIFT PLUS           &kp KP_ASTERISK    &kp CARET        &kp LESS_THAN    &kp GREATER_THAN  &kp AT_SIGN                  &none      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE        &kp RIGHT_BRACE        &mt RIGHT_SHIFT BACKSLASH
&trans                        &trans             &trans           &trans           &trans            &trans                       &trans     &trans                                                                            &trans
            >;
        };

        FUNCTION {
            bindings = <
&kp F1   &kp F2   &kp F3                &kp F4        &kp F5                            &kp F6                   &kp F7          &kp F8            &kp F9      &kp F10
&kp F11  &kp F12  &kp C_BRIGHTNESS_INC  &bt BT_SEL 0  &bt BT_SEL 1  &none       &none   &kp RG(RS(KP_NUMBER_4))  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_VOL_UP
&none    &none    &kp C_BRIGHTNESS_DEC  &bt BT_SEL 2  &bt BT_SEL 3  &none       &none   &none                    &trans          &trans            &trans      &mt C_MUTE C_VOLUME_DOWN
&none    &none    &none                 &trans        &trans        &trans      &trans  &trans                                                                 &kp RS(RG(N4))
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
